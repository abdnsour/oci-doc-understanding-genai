# ==============================================================================
# OCI Document Understanding & Generative AI Pipeline - Configuration Template
# ==============================================================================

# OCI Authentication Profile
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..your_compartment_ocid_here

# OCI Object Storage (Document Understanding Processor Job Output)
OCI_NAMESPACE=your_tenancy_namespace
OCI_BUCKET_NAME=doc-understanding-bucket
OCI_OUTPUT_PREFIX=doc_understanding_output

# OCI Generative AI Inference
OCI_GENAI_MODEL_ID=ocid1.generativeaimodel.oc1.phx.your_model_ocid_here

# Local Input Directory for PDF Documents
INPUT_PDF_DIR=./sample_documents
